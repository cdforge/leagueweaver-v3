{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-cinematic/types/**/*.ts",
    ".next-cinematic/dev/types/**/*.ts",
    ".next-connect/types/**/*.ts",
    ".next-connect/dev/types/**/*.ts",
    ".next-workercheck/types/**/*.ts",
    ".next-workercheck/dev/types/**/*.ts",
    ".next-wt/types/**/*.ts",
    ".next-wt/dev/types/**/*.ts",
    ".next-verify3/types/**/*.ts",
    ".next-verify3/dev/types/**/*.ts",
    ".next-mergecheck/types/**/*.ts",
    ".next-mergecheck/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib/engine/v3/adapters"
  ]
}
