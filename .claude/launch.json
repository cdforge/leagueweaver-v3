{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "leagueweaver-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "leagueweaver-qa",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--port", "3200"],
      "env": { "NEXT_DIST_DIR": ".next-qa" },
      "port": 3200,
      "autoPort": true
    }
  ]
}
