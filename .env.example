# League Weaver — environment variable template
# -----------------------------------------------------------------------------
# This file lists the variable NAMES the app expects. It contains NO secret
# values and is safe to commit. Copy it to `.env.local` and fill in real values.
#
# --- Supabase (REQUIRED) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVITE_ALLOWED_EMAILS=

# --- Stripe (required to charge for Pro) -------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRO_PRICE_ID=
STRIPE_ANNUAL_PRO_PRICE_ID=
STRIPE_SINGLE_SCHEDULE_PRO_PRICE_ID=

# --- Billing mode: "enforced" to gate/charge, anything else = "preview" ------
NEXT_PUBLIC_SCHEDULE_FORGE_BILLING_MODE=preview

# --- Google AdSense (free-tier monetization) ---------------------------------
# CLIENT_ID is your "ca-pub-XXXXXXXXXXXXXXXX" publisher id. Ads only render when
# CLIENT_ID and the matching per-placement SLOT id are both set — leave blank
# until AdSense approves the site. Also mirror CLIENT_ID into public/ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_WORKSPACE=
NEXT_PUBLIC_ADSENSE_SLOT_PUBLIC=

# --- AI assistants (PHASE 2 — leave blank for MVP; prefer Anthropic when on) --
# When re-enabled, wire these to Anthropic (Claude) rather than the legacy provider.
OPENAI_API_KEY=
OPENAI_CANDIDATE_SCORER_MODEL=
OPENAI_FAILURE_EXPLAINER_MODEL=
OPENAI_SETUP_ADVISOR_MODEL=
OPENAI_TRADEOFF_SUMMARY_MODEL=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=
FEEDBACK_FROM_EMAIL=
FEEDBACK_TO_EMAIL=
ENABLE_TEST_EMAIL_ENDPOINT=

# --- SMS (Twilio) ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# --- Maps (Google Geocoding) -------------------------------------------------
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_SEARCH_ENABLED=
NEXT_PUBLIC_GOOGLE_PLACES_AUTOCOMPLETE_READY=

# --- App URL / hosting (MUST be environment-driven — do not hardcode) --------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
VERCEL_ENV=

# --- Coming-soon gate --------------------------------------------------------
SITE_COMING_SOON=
SITE_COMING_SOON_HOSTS=

# --- Engine / dev ------------------------------------------------------------
LW_USE_V3=
LW_DEV_DISTDIR=
FLAGS=
SCHEDULEFORGE_DEBUG=
# Vercel AI Gateway (screenshot import)
AI_GATEWAY_API_KEY=
AI_SCREENSHOT_MODEL=anthropic/claude-sonnet-5

# --- Platform sync credential encryption ------------------------------------
# Required before saving private ESPN SWID / espn_s2 values server-side.
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=

# --- Cron jobs (Vercel) ------------------------------------------------------
# vercel.json schedules the score-sync crons that call /api/cron/sync-scores;
# that route checks this secret (Vercel sends `Authorization: Bearer <CRON_SECRET>`).
# Set it in the Vercel dashboard, NOT here. Generate with `openssl rand -hex 32`
# and paste it on a SINGLE LINE — a stray newline makes `next build` fail with
# "CRON_SECRET contains characters that are not valid in HTTP headers".
CRON_SECRET=
